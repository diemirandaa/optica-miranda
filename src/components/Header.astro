---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '../assets/logo.png';
import { site } from '../data/site';

const links = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#como-comprar', label: 'Cómo comprar' },
  { href: '/#local', label: 'El local' },
  { href: '/#preguntas', label: 'Preguntas' },
];
---
<header class="fixed inset-x-0 top-0 z-40 px-4 pt-3 md:pt-4">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 rounded-full border border-line bg-surface/75 pl-5 pr-2 backdrop-blur-xl backdrop-saturate-150"
    aria-label="Principal"
  >
    <a href="/" class="shrink-0" aria-label="Óptica Miranda, inicio">
      <Image src={logo} alt="" width={84} class="h-auto w-[72px] md:w-[84px]" loading="eager" />
    </a>
    <ul class="hidden items-center gap-1 text-[15px] font-medium text-muted lg:flex">
      {links.map((l) => (
        <li><a href={l.href} class="rounded-full px-4 py-2 transition-colors hover:bg-tint hover:text-ink">{l.label}</a></li>
      ))}
    </ul>
    <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-primary !py-2.5 !pl-2.5 !pr-4 text-[15px]">
      <span class="btn-dot !h-8 !w-8"><Icon name="ph:whatsapp-logo-bold" class="h-[18px] w-[18px]" /></span>
      Escribinos
    </a>
  </nav>
</header>
